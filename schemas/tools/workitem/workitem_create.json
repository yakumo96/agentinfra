{
  "$schema": "../../tool-definition.schema.json",
  "name": "workitem_create",
  "group": "workitem",
  "description": "创建工作项。scope_paths 只是提示，不加锁。",
  "mutates": true,
  "roles": [
    "coordinator",
    "admin"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "idempotency_key": {
        "$ref": "../../common/defs.json#/$defs/IdempotencyKey"
      },
      "repo": {
        "$ref": "../../common/defs.json#/$defs/RepoId"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "spec": {
        "type": "string"
      },
      "acceptance": {
        "type": "string"
      },
      "scope_paths": {
        "type": "array",
        "items": {
          "$ref": "../../common/defs.json#/$defs/Glob"
        }
      },
      "depends_on": {
        "type": "array",
        "items": {
          "$ref": "../../common/defs.json#/$defs/WorkItemId"
        }
      },
      "priority": {
        "type": "integer",
        "default": 0
      }
    },
    "additionalProperties": false,
    "required": [
      "idempotency_key",
      "repo",
      "title",
      "spec",
      "acceptance"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "work_item_id": {
        "$ref": "../../common/defs.json#/$defs/WorkItemId"
      }
    },
    "additionalProperties": false,
    "required": [
      "work_item_id"
    ]
  }
}
