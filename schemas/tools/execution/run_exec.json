{
  "$schema": "../../tool-definition.schema.json",
  "name": "run_exec",
  "group": "execution",
  "description": "在工作区的容器里同步执行命令；结束时提交工作区改动。",
  "mutates": true,
  "roles": [
    "worker",
    "admin"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "idempotency_key": {
        "$ref": "../../common/defs.json#/$defs/IdempotencyKey"
      },
      "workspace_id": {
        "$ref": "../../common/defs.json#/$defs/WorkspaceId"
      },
      "command": {
        "type": "string",
        "minLength": 1
      },
      "cwd": {
        "$ref": "../../common/defs.json#/$defs/Path"
      },
      "secrets": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "description": "按名字注入的秘密环境变量"
      },
      "timeout_s": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400,
        "default": 600
      }
    },
    "additionalProperties": false,
    "required": [
      "idempotency_key",
      "workspace_id",
      "command"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "run_id": {
        "$ref": "../../common/defs.json#/$defs/RunId"
      },
      "state": {
        "$ref": "../../common/defs.json#/$defs/RunState"
      },
      "exit_code": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "stdout": {
        "type": "string"
      },
      "stderr": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "stdout_artifact_id": {
        "anyOf": [
          {
            "$ref": "../../common/defs.json#/$defs/ArtifactId"
          },
          {
            "type": "null"
          }
        ]
      },
      "stderr_artifact_id": {
        "anyOf": [
          {
            "$ref": "../../common/defs.json#/$defs/ArtifactId"
          },
          {
            "type": "null"
          }
        ]
      },
      "output_commit": {
        "anyOf": [
          {
            "$ref": "../../common/defs.json#/$defs/CommitId"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "run_id",
      "state",
      "exit_code",
      "stdout",
      "stderr",
      "truncated",
      "stdout_artifact_id",
      "stderr_artifact_id",
      "output_commit"
    ]
  },
  "harness_builtin": [
    "bash"
  ]
}
