{
  "$schema": "../../tool-definition.schema.json",
  "name": "rev_search",
  "group": "version",
  "description": "在某个版本里按正则搜索文本。",
  "mutates": false,
  "roles": [
    "coordinator",
    "worker",
    "admin"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "$ref": "../../common/defs.json#/$defs/RepoId"
      },
      "revision": {
        "$ref": "../../common/defs.json#/$defs/VersionSpec"
      },
      "pattern": {
        "type": "string",
        "minLength": 1
      },
      "glob": {
        "$ref": "../../common/defs.json#/$defs/Glob"
      },
      "cursor": {
        "$ref": "../../common/defs.json#/$defs/Cursor"
      }
    },
    "additionalProperties": false,
    "required": [
      "repo",
      "revision",
      "pattern"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "matches": {
        "type": "array",
        "items": {
          "$ref": "../../common/defs.json#/$defs/Match"
        }
      },
      "next_cursor": {
        "anyOf": [
          {
            "$ref": "../../common/defs.json#/$defs/Cursor"
          },
          {
            "type": "null"
          }
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "additionalProperties": false,
    "required": [
      "matches",
      "next_cursor",
      "truncated"
    ]
  }
}
