{
  "$schema": "../../tool-definition.schema.json",
  "name": "ws_log",
  "group": "workspace",
  "description": "工作区分支上的逐步 commit：每次改文件的工具调用一个。",
  "mutates": false,
  "roles": [
    "worker",
    "admin"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_id": {
        "$ref": "../../common/defs.json#/$defs/WorkspaceId"
      },
      "path": {
        "$ref": "../../common/defs.json#/$defs/Path"
      },
      "cursor": {
        "$ref": "../../common/defs.json#/$defs/Cursor"
      },
      "limit": {
        "$ref": "../../common/defs.json#/$defs/Limit"
      }
    },
    "additionalProperties": false,
    "required": [
      "workspace_id"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "commits": {
        "type": "array",
        "items": {
          "$ref": "../../common/defs.json#/$defs/Commit"
        }
      },
      "next_cursor": {
        "anyOf": [
          {
            "$ref": "../../common/defs.json#/$defs/Cursor"
          },
          {
            "type": "null"
          }
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "additionalProperties": false,
    "required": [
      "commits",
      "next_cursor",
      "truncated"
    ]
  }
}
