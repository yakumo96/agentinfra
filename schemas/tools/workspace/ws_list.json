{
  "$schema": "../../tool-definition.schema.json",
  "name": "ws_list",
  "group": "workspace",
  "description": "列目录。",
  "mutates": false,
  "roles": [
    "worker",
    "admin"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace_id": {
        "$ref": "../../common/defs.json#/$defs/WorkspaceId"
      },
      "path": {
        "$ref": "../../common/defs.json#/$defs/Path"
      },
      "depth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 32,
        "default": 1
      },
      "cursor": {
        "$ref": "../../common/defs.json#/$defs/Cursor"
      }
    },
    "additionalProperties": false,
    "required": [
      "workspace_id"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "entries": {
        "type": "array",
        "items": {
          "$ref": "../../common/defs.json#/$defs/Entry"
        }
      },
      "next_cursor": {
        "anyOf": [
          {
            "$ref": "../../common/defs.json#/$defs/Cursor"
          },
          {
            "type": "null"
          }
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "additionalProperties": false,
    "required": [
      "entries",
      "next_cursor",
      "truncated"
    ]
  }
}
